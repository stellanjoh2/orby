#!/bin/sh
# Bump VERSION + index.html tags/changelog into the tip commit (amend), so one push
# = one Pages deploy. Requires: npm run setup-hooks (sets core.hooksPath .githooks).
# Legacy .git/hooks/pre-push without amend left staged files — see scripts/setup-git-hooks.mjs

set -e

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" = "main" ] || exit 0

if ! git rev-parse --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  exit 0
fi

ahead=$(git rev-list --count '@{u}..HEAD')
[ "$ahead" -ge 1 ] || exit 0

node scripts/update-version.js

git add VERSION index.html partials/

if git diff --cached --quiet; then
  exit 0
fi

git commit --amend --no-edit
