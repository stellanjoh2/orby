{
  "name": "orby",
  "version": "0.5.123",
  "description": "A completely free, zero-install, drag-and-drop 3D model viewer",
  "type": "module",
  "scripts": {
    "start": "node scripts/static-dev-server.mjs",
    "dev": "node scripts/static-dev-server.mjs",
    "restart": "node -e \"require('child_process').execSync('lsof -ti :8000 | xargs kill -9 2>/dev/null||true',{stdio:'inherit'})\" && node scripts/static-dev-server.mjs",
    "dev:python": "python3 -m http.server 8000 --bind 0.0.0.0",
    "build": "node build.js",
    "bundle:marketing-css": "node scripts/marketing/bundleMarketingCss.mjs",
    "subset:fontawesome": "node scripts/buildFontAwesomeSubset.mjs",
    "inject:subpage-nav": "node scripts/marketing/injectSubpageSiteNav.mjs",
    "encode:turntable": "node scripts/marketing/encodeIntroTurntableFrames.mjs",
    "encode:png-marquee": "node scripts/marketing/encodePngMarquee.mjs",
    "export:marketing-copy": "node scripts/marketing/exportMarketingCopy.mjs",
    "encode:hdri": "python3 scripts/encodeHdriPresets.py",
    "preview": "python3 -m http.server 8000 --bind 0.0.0.0 -d dist",
    "setup-hooks": "node scripts/setup-git-hooks.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs || true",
    "test": "node --test scripts/render/capture/*.test.mjs",
    "test:e2e:dimension": "playwright test e2e/export-dimension-spot-checks.spec.mjs",
    "test:all": "npm test && npm run test:e2e:dimension"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "cdt2d": "^1.0.0",
    "esbuild": "^0.19.0",
    "gsap": "^3.12.7",
    "n8ao": "^1.10.1",
    "postprocessing": "^6.36.4"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "subset-font": "^2.3.0"
  }
}
