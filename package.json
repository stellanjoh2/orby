{
  "name": "orby",
  "version": "0.5.123",
  "description": "Free browser-based 3D viewer and virtual studio — GLB/SVG, local-only, no account",
  "type": "module",
  "scripts": {
    "start": "node scripts/static-dev-server.mjs",
    "dev": "node scripts/static-dev-server.mjs",
    "restart": "node -e \"require('child_process').execSync('lsof -ti :8000 | xargs kill -9 2>/dev/null||true',{stdio:'inherit'})\" && node scripts/static-dev-server.mjs",
    "import:shape-library-thumbs": "node scripts/dev/importShapeLibraryThumbnails.mjs",
    "dev:python": "python3 -m http.server 8000 --bind 0.0.0.0",
    "build": "node build.js",
    "verify:production-env": "node scripts/verifyProductionEnv.mjs",
    "bundle:marketing-css": "node scripts/marketing/bundleMarketingCss.mjs",
    "subset:fontawesome": "node scripts/buildFontAwesomeSubset.mjs",
    "inject:subpage-nav": "node scripts/marketing/injectSubpageSiteNav.mjs",
    "encode:turntable": "node scripts/marketing/encodeIntroTurntableFrames.mjs",
    "encode:png-marquee": "node scripts/marketing/encodePngMarquee.mjs",
    "export:marketing-copy": "node scripts/marketing/exportMarketingCopy.mjs",
    "encode:hdri": "python3 scripts/encodeHdriPresets.py",
    "preview": "python3 -m http.server 8000 --bind 0.0.0.0 -d dist",
    "setup-hooks": "node scripts/setup-git-hooks.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs || true",
    "test": "node --test scripts/stitchIndexHtml.test.mjs scripts/browserDetection.test.mjs scripts/render/capture/*.test.mjs scripts/render/drawingBufferSize.test.mjs scripts/render/backgroundImage/backgroundImageDefaults.test.mjs scripts/render/gltfBlendMapAlphaCutout.test.mjs scripts/render/gltfSpecGlossConversion.test.mjs scripts/render/importPhysicalGlassPresentation.test.mjs scripts/render/creativeLookPhysicalTransmission.test.mjs scripts/render/AnimationController.exportDrive.test.mjs scripts/render/mapInspectChannelMaterial.test.mjs scripts/render/meshglN8aoBackdrop.test.mjs scripts/render/meshglN8aoViewCache.test.mjs scripts/render/videoRecorderFormat.test.mjs scripts/render/materialBrightnessMetalnessClamp.test.mjs scripts/render/materialColorOverrideAlbedo.test.mjs scripts/import/fontCircularGeometryNormalize.test.mjs scripts/scene/fontTextTrackingAnimation.test.mjs scripts/scene/fontTextConstantTypes.test.mjs scripts/state/materialBrightnessScale.test.mjs",
    "test:e2e:dimension": "playwright test e2e/export-dimension-spot-checks.spec.mjs",
    "test:all": "npm test && npm run test:e2e:dimension"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "cdt2d": "^1.0.0",
    "gsap": "^3.12.7",
    "n8ao": "^1.10.3",
    "postprocessing": "^6.36.4"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "esbuild": "^0.19.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "subset-font": "^2.3.0"
  }
}
